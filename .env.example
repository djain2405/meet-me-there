# Public site URL (used for copy-link buttons)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Admin dashboard password (required in production)
ADMIN_PASSWORD=demo

# Turso / libSQL (required in production on Vercel)
# Local `next dev` falls back to file:data/meet-me-there.db when unset.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Seed Riverside demo data (default: on in development, off in production)
# SEED_DEMO=true
